# 雲端硬碟同步資料夾的本機路徑(手機錄音 App 同步到此資料夾)
WATCH_FOLDER_PATH=C:\Users\yourname\Google Drive\Recordings

# Anthropic API 金鑰,供 Claude API 使用(將逐字稿結構化成標題/摘要/重點/行動項目/分類標籤)
# 於 https://console.anthropic.com 申請,與 Claude Pro/Claude Code 訂閱是分開計費的
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion Internal Integration Token,供 notion-client 讀寫 Notion 使用
# 於 https://www.notion.so/my-integrations 建立一個 Internal Integration 後取得
# 建立後記得把目標頁面/資料庫分享(Share)給這個 integration,否則會沒有存取權限
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion 筆記資料庫 ID,執行 src/setup_notion_database.py 建立資料庫後,
# 將腳本輸出的資料庫 ID 貼在這裡
NOTION_DATABASE_ID=

# 建立筆記資料庫時,掛在哪一個 Notion 頁面底下(該頁面須已分享給上面的 integration)
# 從該頁面的網址複製最後一段 32 碼 ID(可含或不含連字號)
NOTION_PARENT_PAGE_ID=

# 本地轉錄虛擬環境(faster-whisper)所在路徑的 python.exe
# 例如建立於專案根目錄下的 .venv-transcribe
TRANSCRIBE_VENV_PYTHON=.venv-transcribe\Scripts\python.exe

# faster-whisper 使用的模型大小(large-v3 準確度最高,需要較多 VRAM/時間)
WHISPER_MODEL_SIZE=large-v3

# VAD 靜音過濾(語音活動偵測):自動跳過錄音中的靜音片段,加速轉錄並減少幻聽誤轉
# 預設 true;若發現小聲說話被誤判成靜音而漏轉(例如遠距離收音),可改為 false
VAD_FILTER=true

# 單一檔案失敗重試的最大次數,超過後標記為需人工介入,不再自動重試
MAX_RETRY_COUNT=3

# 語者分離(標註逐字稿裡「語者 A/B」是誰說的):預設 false,不影響一般錄音的行為/效能
# 想分析訪談等需要分辨語者的錄音時,才手動改成 true 並跑一次 run_now.bat,用完可以改回 false
SPEAKER_DIARIZATION_ENABLED=false

# Hugging Face 存取權杖,SPEAKER_DIARIZATION_ENABLED=true 時才需要,語者分離模型下載用
# 於 https://huggingface.co/settings/tokens 建立一組 token(read 權限即可)
# 並先到 https://huggingface.co/pyannote/speaker-diarization-3.1 與
# https://huggingface.co/pyannote/segmentation-3.0 這兩個頁面登入後接受授權條款,
# 否則第一次啟用語者分離時模型下載會失敗
HUGGINGFACE_TOKEN=
